{
  "name": "lokameet",
  "private": true,
  "version": "2.0.0",
  "description": "LokaMeet 2.0.0 — мессенджер и видеосвязь в локальной сети без интернета. Чаты, смайлы, файлы, звонки P2P, конференции до 15 человек, демонстрация экрана, управление рабочим столом, запись, игры.",
  "author": "mistrwest",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json -w --preserveWatchOutput",
    "dev:vite": "vite",
    "dev:electron": "wait-on dist/main/index.js dist/preload/preload.js http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.17",
    "bonjour-service": "^1.3.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.468.0",
    "mediasoup": "3.15.2",
    "mediasoup-client": "3.7.17",
    "mp4-muxer": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "local.lokameet.app",
    "productName": "LokaMeet",
    "icon": "public/icon.png",
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/mediasoup/**",
      "public/mediapipe/**",
      "public/models/**"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      },
      {
        "from": "public/icon.png",
        "to": "icon.png"
      },
      {
        "from": "public/mediapipe",
        "to": "mediapipe"
      },
      {
        "from": "public/models",
        "to": "models"
      },
      {
        "from": "public/backgrounds",
        "to": "backgrounds"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "LokaMeet-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LokaMeet",
      "artifactName": "LokaMeet-Setup-${version}.${ext}"
    }
  }
}
