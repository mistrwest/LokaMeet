# Dependencies
node_modules/

# Build outputs
dist/
release/

# Runtime logs (keep folder via .gitkeep)
logs/*
!logs/.gitkeep
*.log

# Cursor / IDE
.cursor/
.vscode/
*.swp
*.swo

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Secrets / local env
.env
.env.*
!.env.example

# Accidental compile artifacts in src
src/**/*.js
!src/**/*.cjs

# MediaPipe wasm копируется из node_modules при сборке
public/mediapipe/wasm/
